<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <!-- 不叫 DiskCleaner.exe：Glary Utilities 的磁碟清理也叫這個名字，工作管理員裡會分不清。 -->
    <AssemblyName>DiskSweeper</AssemblyName>
    <RootNamespace>DiskCleaner</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 檔案總管、工作列看到的執行檔圖示（16～256 各一張）。 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 64 位元系統上要用 64 位元跑：32 位元程式看到的 System32 會被轉向，路徑會判斷錯。 -->
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- 測試專案在 Tests 底下，有自己的 csproj，不要編進主程式。 -->
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- 各語言介面的字典（每行「繁體中文、Tab、譯文」），見 Lang.cs。 -->
    <EmbeddedResource Include="en.txt" LogicalName="DiskCleaner.en.txt" />
    <EmbeddedResource Include="zh-CN.txt" LogicalName="DiskCleaner.zh-CN.txt" />
    <EmbeddedResource Include="ja.txt" LogicalName="DiskCleaner.ja.txt" />
    <EmbeddedResource Include="ko.txt" LogicalName="DiskCleaner.ko.txt" />
    <!-- 視窗與系統匣也用同一個圖示。 -->
    <EmbeddedResource Include="app.ico" LogicalName="DiskCleaner.app.ico" />
  </ItemGroup>

</Project>
